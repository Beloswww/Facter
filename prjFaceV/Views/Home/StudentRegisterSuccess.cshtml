@{
    Layout = null;
}

<!-- 註冊成功頁面 -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Successful</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <style>
        body {
            padding-top: 50px; /* 調整上方間距 */
          
        }

        h1 {
            font-size: 3em; /* 調整標題字體大小 */
            font-weight: bold; /* 加粗字體 */
            margin-bottom: 50px; /* 調整標題底部間距 */
        }

        p {
            font-size: 1.2em; /* 調整段落字體大小 */
            margin-bottom: 15px; /* 調整段落底部間距 */
        }


        span#countdown {
            color: #FF6347; /* 設定顯眼的顏色 */
            font-weight: bold; /* 加粗字體 */
        }


        img#tick {
            width: 115px; /* 調整勾勾照片大小 */
            margin-bottom: 20px; /* 調整底部間距 */
        }
    </style>
</head>

<body>
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-6 offset-md-3 text-center">
                <h1 class="text-success">註冊成功</h1>
                <img src="~/images/勾勾.png" alt="勾勾" id="tick" class="img-fluid">
                <p>帳號已成功註冊!</p>
                <p>回到學生登入和註冊頁面 <span id="countdown">3</span> 秒...</p>
                <script>
                    // 設定初始倒數時
                    var countdown = 2;

                    // 更新倒數時間的顯示
                    function updateCountdown() {
                        document.getElementById('countdown').innerText = countdown;
                    }

                    // 在頁面載入後，定時器每秒更新倒數時間，並在倒數為0時跳轉到首頁
                    var countdownInterval = setInterval(function () {
                        updateCountdown();
                        countdown--;

                        if (countdown < 0) {
                            clearInterval(countdownInterval);
                            window.location.href = "/";
                        }
                    }, 1000);
                </script>
            </div>
        </div>
    </div>
</body>
</html>