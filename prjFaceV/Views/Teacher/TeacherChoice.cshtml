@{
    Layout = null;
}
<!-- 最一開始的登入頁面 -->
<!DOCTYPE html>
<html lang="en">
<script>
    function redirectToPage(url) {
        console.log("Redirecting to:", url);
        window.location.href = url;
    }
</script>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            position: relative;
            min-height: 105vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-family: 'Comic Sans MS', 'Comic Sans', cursive;
            background-color: #E6E6FA;
        }

        .title {
            position: absolute;
            top: 0px;
            left: 42%;
            color: black;
            font-size: 5em;
        }

        .card {
            background-color: #fff;
            color: #000;
            border: 1px solid #ccc;
            margin-bottom: 50px;
            padding: 120px; /* 調整內間距 */
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-top: 20px; /* 調整上邊距 */
            width: 120%; /* 調整卡片寬度 */
            font-family: 'Microsoft JhengHei', sans-serif;
            position: relative; /* 新增 */
            margin-left: 50px;
        }


        .tttprivacy-policy-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: absolute; /* 新增 */
            top: 50%; /* 新增 */
            left: 50%; /* 新增 */
            transform: translate(-50%, -50%); /* 新增 */
        }


            .tttprivacy-policy-container img {
                width: 100%;
                height: auto;
                max-width: 200px;
                display: block;
                margin-bottom: 20px;
                margin-right:70px;
            }

        .right-column {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top:30px;
        }

        .top-student-box,
        .row {
            margin-bottom: 10px;
        }

        .container {
            display: flex;
        }

        .student-box {
            width: 240px; /* 調整寬度 */
            text-align: center;
            cursor: pointer;
            padding: 50px;
            margin: 30px;
            border: 1px solid #cccccc;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-left: 120px;
            margin-right: 30px;
            margin-top: 0px;
            transition: transform 0.3s ease-out;
            background-color: #cccccc;
            font-family: 'Microsoft JhengHei', sans-serif;
        }

        .student-box1 {
            width: 240px; /* 調整寬度 */
            text-align: center;
            cursor: pointer;
            padding: 50px;
            margin: 30px;
            border: 1px solid #cccccc;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-left: 0px;
            margin-right: 30px;
            margin-top: 0px;
            transition: transform 0.3s ease-out;
            background-color: #cccccc;
            font-family: 'Microsoft JhengHei', sans-serif;
        }

        .logout-btn {
            margin-top: 2em;
            margin-left: -100px;
        }


        .student-box:hover {
            transform: translateY(-5px) scale(1.05);
        }

        .student-box1:hover {
            transform: translateY(-5px) scale(1.05);
        }
    </style>

</head>
<body>
    <form method="post" action="@Url.Action("TeacherChoice")" enctype="multipart/form-data">


        <div class="container">


            <div class="container">
                <div class="row gx-5 align-items-stretch">
                    <!-- 上半部 -->
                    <div class="col-md-8 offset-md-1">
                        <div class="card">
                            <div class="tttprivacy-policy-container">
                                <div class="row gx-2 align-items-stretch">
                                    <div class="col-md-5">
                                        <img src="~/images/人頭像.png" alt="人頭像" class="img-fluid">
                                    </div>
                                    <div class="col-md-5">
                                        <div class="right-column">
                                            <p>名字: @ViewBag.Name 老師</p>
                                            <p>工號: @ViewBag.TeacherID</p>
                                            <p>gmail: @ViewBag.Gmail</p>
                                            <a href="@Url.Action("Logout")" class="btn btn-outline-secondary btn-student">登出</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row gx-5 align-items-stretch justify-content-around">
                        <div class="col-md-4 ">
                            <div class="student-box" onclick="toggleLoginForm('@Url.Action("teacher-form")')">
                                <img src="~/images/10293888.png" alt="點名" class="img-fluid">
                                <p><a href="@Url.Action("RollCall")" class="btn btn-outline-secondary btn-teacher mt-3">進行點名</a></p>
                                <h3>@ViewBag.Err</h3>
                            </div>
                        </div>


                        <div class="col-md-4">
                            <div class="student-box1" onclick="toggleLoginForm('@Url.Action("teacher-form")')">
                                <img src="~/images/71403.png" alt="查詢" class="img-fluid">
                                <p><a href="@Url.Action("Record")" class="btn btn-outline-secondary btn-teacher mt-3">紀錄查詢</a></p>
                                <h3>@ViewBag.Err</h3>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
</body>
</html>