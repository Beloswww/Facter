<!DOCTYPE html>
<!-- 點名頁面 -->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>進行點名</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background-color: #f8f9fa;
            color: #343a40;
            font-family: 'Open Sans', sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .container {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .card {
            background-color: #fff;
            color: #000;
            border: 1px solid #ccc;
            margin-bottom: 20px;
            padding: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .tttprivacy-policy-container {
            margin-top: auto; /* 將 margin-top 設為 auto，使其在 flex 容器中垂直居中 */
        }

            .tttprivacy-policy-container img {
                width: 100%;
                height: auto;
                max-width: 200px;
                display: block;
                margin-bottom: 20px; /* 調整圖片與文字之間的間距 */
            }

        h1 {
            text-align: center;
            color: #000;
        }

        /* 调整右侧输入框字体大小 */
        .card .form-control {
            font-size: 14px; /* 设置合适的字体大小 */
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row gx-5 align-items-stretch">
            <!-- 左半部 -->
            <div class="col-md-5">
                <div class="card">
                    <div class="tttprivacy-policy-container">
                        <img src="~/images/人頭像.png" alt="人頭像">
                        <p>名字: @ViewBag.Name 老師</p>
                        <p>工號: @ViewBag.TeacherID</p>
                        <p>gmail: @ViewBag.Gmail</p>
                    </div>
                </div>
            </div>

            <!-- 右半部 -->
            <div class="col-md-7">
                <div class="card">
                    <form method="post" action="@Url.Action("RollCall")" enctype="multipart/form-data">
                        <h1 class="mb-4">進行點名</h1>
                        @ViewBag.Name 老師您好!
                        <p></p>
                        <div class="mb-3 row">
                            <label for="start" class="form-label col-sm-4">課堂日期:</label>
                            <div class="col-sm-7">
                                <input type="date" id="start" name="date" class="form-control">
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label for="course" class="form-label col-sm-4">選擇課堂:</label>
                            <div class="col-sm-7">
                                <select id="course" name="selectedCourse" class="form-select">
                                    <option>請選擇課堂...</option>
                                    <option>資料庫系統</option>
                                    <option>機率與統計</option>
                                    <option>人生哲學</option>
                                    <option>微處理機系統</option>
                                    <option>網路概論</option>
                                    <option>深度學習</option>
                                </select>
                            </div>
                        </div>


                        <div class="mb-3 row">
                            <label for="pic" class="form-label col-sm-4">上傳點名照片:</label>
                            <div class="col-sm-7">
                                <input type="file" name="pic" id="pic" class="form-control">
                            </div>
                        </div>

                        <div class="mb-3">
                            <input type="submit" value="進行點名" class="btn btn-outline-secondary">
                        </div>

                        <hr>
                        <h3>@ViewBag.Err</h3>
                    </form>
                  
                </div>
            </div>
        </div>
    </div>
</body>
</html>
