@*@model IEnumerable<System.IO.FileInfo>*@
@model IEnumerable<prjFaceV.Models.rollcallTable>
@{
    Layout = null;
}
<!-- 出缺席輸出頁面 -->
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>LoginOK</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 50vh;
            background-color: #E6E6FA;
        }

        .container {
            text-align: center;
        }

        h1 {
            color: #007bff; /* 根據需要更改標題顏色 */
            font-family: 'Arial', sans-serif; /* 根據需要更改字體家族 */
            font-weight: bold; /* 加粗字體 */
            margin-bottom: 70px; /* 添加底邊距，創造距離 */
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3); /* 文字陰影效果 */
        }

        h3 {
            color: #dc3545;
            font-size: 20px;
        }

        .card {
            background-color: #fff;
            color: #000;
            border: 1px solid #ccc;
            margin-bottom: 10px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

            .card img {
                width: 80%; /* 設定圖片寬度為 100%，使其自適應容器大小 */
                height: auto; /* 讓高度自動調整，以保持圖片比例 */
                margin-bottom: 15px;
            }


        body .container {
            margin-top: 60px !important;
        }

        label {
            text-align: center;
            display: block;
        }

        /* 新增的樣式 */
        #course {
            max-width: 500px; /* 調整下拉式選單的最大寬度 */
        }

        #btnSubmit {
            margin-left: 150px; /* 調整按鈕的左邊距 */
            margin-top: -55px; /* 調整按鈕的上邊距 */
        }

        /* 新增的樣式 */
        #scrollTable {
            max-height: 400px; /* 調整滾輪式清單的最大高度 */
            overflow-y: auto; /* 使用滾輪條 */
        }
    </style>


</head>
<body>

    <div class="container mt-3">
        <h1>點名成功</h1>
        @ViewBag.test
        @ViewBag.date
        <table class="table table-hover">
            <thead>
                <tr class="table-primary">
                    <td>
                        @Html.LabelFor(m => m.FirstOrDefault().Department)
                    </td>
                    <td>
                        @Html.LabelFor(m => m.FirstOrDefault().Grade)
                    </td>
                    <td>
                        @Html.LabelFor(m => m.FirstOrDefault().StudentID)
                    </td>
                    <td>
                        @Html.LabelFor(m => m.FirstOrDefault().Name)
                    </td>
                    <td>
                        @Html.LabelFor(m => m.FirstOrDefault().Absent)
                    </td>
                </tr>
            </thead>
            <tbody>

                @foreach (var i in Model)
                {
                    <tr>
                        <td>@i.Department</td>
                        <td>@i.Grade 年級</td>
                        <td>@i.StudentID</td>
                        <td>@i.Name</td>
                        <td>@i.Absent</td>
                    </tr>

                }
            </tbody>
        </table>
        <a href="@Url.Action("TeacherChoice")" class="btn btn-outline-secondary btn-student mt-3">返回選單</a>
    </div>
    
</body>
</html>