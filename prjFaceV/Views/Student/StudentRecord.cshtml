@model IEnumerable<prjFaceV.Models.totalTable>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Record</title>

    <style>

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 50vh;
            background-color: #E6E6FA;        
        }

        .container {
            text-align: center;
        }

        h1 {
            color: #007bff; /* 根據需要更改標題顏色 */
            font-family: 'Arial', sans-serif; /* 根據需要更改字體家族 */
            font-weight: bold; /* 加粗字體 */
            margin-bottom: 70px; /* 添加底邊距，創造距離 */
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3); /* 文字陰影效果 */
        }
        h3 {
            color: #dc3545;
            font-size: 20px;
        }

     .card {
         background-color: #fff;
         color: #000;
         border: 1px solid #ccc;
         margin-bottom: 10px;
         padding: 20px;
         display: flex;
         flex-direction: column;
         align-items: center;
         text-align: center;
     }

        .card img {
            width: 80%; /* 設定圖片寬度為 100%，使其自適應容器大小 */
            height: auto; /* 讓高度自動調整，以保持圖片比例 */
            margin-bottom: 15px;
        }


        body .container {
            margin-top: 60px !important;
        }

        label {
            text-align: center;
            display: block;
        }

        /* 新增的樣式 */
        #course {
            max-width: 500px; /* 調整下拉式選單的最大寬度 */
        }

        #btnSubmit {
            margin-left: 150px; /* 調整按鈕的左邊距 */
            margin-top: -55px; /* 調整按鈕的上邊距 */
        }

        /* 新增的樣式 */
        #scrollTable {
            max-height: 400px; /* 調整滾輪式清單的最大高度 */
            overflow-y: auto; /* 使用滾輪條 */
        }


      </style>

</head>


<body>
    <div class="container mt-3">
        <h1>出席紀錄查詢</h1>
        <div class="row">
            <!-- 左側區域 -->
            <div class="col-md-3 mb-3">
                <div class="card">
                    <img src="~/images/學生頭像.png" alt="Student" class="img-fluid">
                    <div class="card-body">
                        <p class="card-text">系級: @ViewBag.Department @ViewBag.Grade 年級</p>
                        <p class="card-text">學號: @ViewBag.StudentID</p>
                        <p class="card-text">名字: @ViewBag.Name 同學</p>
                        <a href="@Url.Action("Logout")" class="btn btn-outline-secondary btn-student mt-3">登出</a>
                    </div>
            </div>
        </div>

            <div class="col-md-9">
                <form action="@Url.Action("StudentRecord")" method="post">
                    <!-- 下拉式清單選課堂 -->
                    <div class="mb-3">
                        @* <label for="course">選擇課堂:</label>*@
                        <select id="course" name="selectedCourse" class="form-select">
                            <option>請選擇課堂...</option>
                            <option>資料庫系統</option>
                            <option>機率與統計</option>
                            <option>人生哲學</option>
                            <option>微處理機系統</option>
                            <option>網路概論</option>
                            <option>深度學習</option>
                        </select>
                    </div>
                    <div class="mb-3" id="btnSubmit">
                        <input type="submit" value="查詢" class="btn btn-outline-secondary">
                    </div>
                </form>

                @ViewBag.SelectedCourse
                @if (Model == null || Model.Count() <= 0)
                {
                    <p>@ViewBag.Err</p>
                }
                else
                {
                    <!-- 使用滾輪式清單的容器 -->
                    <div id="scrollTable">
                        <table class="table table-hover">
                            <thead>
                                <tr class="table-primary">
                                    <td>
                                        @Html.LabelFor(m => m.FirstOrDefault().Date)
                                    </td>
                                    <td>
                                        @Html.LabelFor(m => m.FirstOrDefault().Absent)
                                    </td>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model)
                                {
                                    <tr>
                                        <td>@i.Date</td>
                                        <td>@i.Absent</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div>
                        <h3>@ViewBag.Err1</h3>
                    </div>
                }
            </div>
               </div>      
    </div>

</body>
</html>
